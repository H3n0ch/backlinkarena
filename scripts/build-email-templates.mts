/**
 * Writes the Supabase auth email templates from lib/email-templates.ts, so they always match
 * the app's emails. Run: npm run emails:build  (add --preview <dir> to also write app-email previews)
 * Then paste each file into Supabase → Authentication → Email Templates (subject is in the file header).
 */
import { mkdirSync, writeFileSync } from "node:fs";
import {
  confirmSignupEmail,
  leadAdminEmail,
  leadConfirmEmail,
  magicLinkEmail,
  welcomeEmail,
  type Rendered,
} from "../lib/email-templates";

const header = (where: string, e: Rendered) =>
  `<!--\n  Supabase → Authentication → Email Templates → "${where}"\n  Subject: ${e.subject}\n  Generated by scripts/build-email-templates.mts. Edit lib/email-templates.ts, not this file.\n-->\n`;

mkdirSync("supabase/templates", { recursive: true });
for (const [file, where, e] of [
  ["confirm-signup.html", "Confirm signup", confirmSignupEmail()],
  ["magic-link.html", "Magic Link", magicLinkEmail()],
] as const) {
  writeFileSync(`supabase/templates/${file}`, header(where, e) + e.html);
  console.log("wrote supabase/templates/" + file);
}

const i = process.argv.indexOf("--preview");
if (i > 0) {
  const dir = process.argv[i + 1];
  const site = "https://backlinkarena.com";
  const lead = { name: "Maria", email: "maria@example.com", what: "Guest posts · 3 links", website: "https://example.com", message: "Looking for links in the fitness niche.", discount: 0.3 };
  const all: Record<string, Rendered> = {
    "1-confirm-signup": confirmSignupEmail(),
    "2-magic-link": magicLinkEmail(),
    "3-welcome": welcomeEmail({ name: "TinyInvest", slug: "tinyhouse-investments", entered: true, siteUrl: site }),
    "4-lead-admin": leadAdminEmail(lead, site),
    "5-lead-confirm": leadConfirmEmail(lead),
  };
  for (const [k, e] of Object.entries(all)) writeFileSync(`${dir}/${k}.html`, e.html);
  console.log("previews in", dir);
}
