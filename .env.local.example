# Copy to .env.local for local dev, and set the same vars in Netlify (Site settings → Environment variables).

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # (legacy NEXT_PUBLIC_SUPABASE_ANON_KEY also works)

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # secret key (or legacy service_role JWT)

# Email address the "Request a quote" buttons in the Services section open.
NEXT_PUBLIC_CONTACT_EMAIL=

# Merchant-of-Record payment link for the $79 Contender Pass (optional until you have it).
NEXT_PUBLIC_PASS_PAYMENT_URL=

# Google One Tap ("Continue as …" vote popup). Same Web client ID as in Supabase → Auth → Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
