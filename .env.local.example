# Copy to .env.local for local dev, and set the same vars in Netlify (Site settings → Environment variables).

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # (legacy NEXT_PUBLIC_SUPABASE_ANON_KEY also works)

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # secret key (or legacy service_role JWT)

# Password for /admin (asked on top of an admin account). Use a long random string.
# Without it the admin panel stays locked. Changing it logs all admins out.
ADMIN_PASSWORD=

# Email address the "Request a quote" buttons in the Services section open.
NEXT_PUBLIC_CONTACT_EMAIL=

# Payments for the $29 guaranteed spot (Contender Pass). Server only. "dodo" (default) or "stripe".
# Leave the active provider's keys empty to show "Coming soon" instead of the buy button.
PAYMENT_PROVIDER=dodo

# Dodo Payments (active). Dashboard → Developer → API keys (dodo_test_... in test mode).
DODO_PAYMENTS_API_KEY=
# test_mode (default) or live_mode. Keys, products and webhooks are separate per mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Products → create a one-time $29 product, paste its id (pdt_...).
DODO_PASS_PRODUCT_ID=
# Developer → Webhooks → add <your site>/api/dodo/webhook with events payment.succeeded and
# refund.succeeded, then copy the endpoint's signing key here. Needs a public URL
# (deployed site, or a tunnel like `ngrok http 3000` locally).
DODO_PAYMENTS_WEBHOOK_KEY=

# Stripe (kept for later: set PAYMENT_PROVIDER=stripe to switch).
# Keys: Stripe Dashboard → Developers → API keys (use sk_test_... while testing).
STRIPE_SECRET_KEY=
# Webhook endpoint: <your site>/api/stripe/webhook, events checkout.session.completed,
# checkout.session.async_payment_succeeded and charge.refunded. Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# Optional: a Price from the Stripe dashboard. Without it, $29 USD is charged.
STRIPE_PASS_PRICE_ID=

# Google One Tap ("Continue as …" vote popup). Same Web client ID as in Supabase → Auth → Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Public address put into badge codes (e.g. https://your-site.netlify.app). On Netlify this
# defaults to the site's own address; set it locally to test badges against the live site.
# PUBLIC_SITE_URL=

# Email through Resend (resend.com). Without RESEND_API_KEY emails are skipped, nothing breaks.
# EMAIL_FROM must use a domain verified in Resend. ADMIN_EMAIL gets lead notifications
# (falls back to NEXT_PUBLIC_CONTACT_EMAIL).
RESEND_API_KEY=
EMAIL_FROM="Backlink Arena <hello@yourdomain.com>"
ADMIN_EMAIL=

# Long random string. The scheduled Netlify job sends it to /api/cron/emails, which sends the
# knockout / results emails. Without it those emails still go out whenever a page or the admin
# runs the engine, just not from the 5-minute job.
CRON_SECRET=

# Google Analytics 4 Measurement ID (G-XXXXXXX). Loads for every visitor.
NEXT_PUBLIC_GA_ID=
# Set to "required" to load GA only after a cookie banner is accepted (e.g. for EU/GDPR).
# NEXT_PUBLIC_ANALYTICS_CONSENT=required
# Google Search Console "HTML tag" method: the content="..." value. Not needed if you verify via DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
