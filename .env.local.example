# Copy to .env.local for local dev, and set the same vars in Netlify (Site settings → Environment variables).

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # (legacy NEXT_PUBLIC_SUPABASE_ANON_KEY also works)

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # secret key (or legacy service_role JWT)

# Password for /admin (asked on top of an admin account). Use a long random string.
# Without it the admin panel stays locked. Changing it logs all admins out.
ADMIN_PASSWORD=

# Email address the "Request a quote" buttons in the Services section open.
NEXT_PUBLIC_CONTACT_EMAIL=

# Stripe for the $79 guaranteed spot (Contender Pass). Server only. Leave empty to hide the buy button.
# Keys: Stripe Dashboard → Developers → API keys (use sk_test_... while testing).
STRIPE_SECRET_KEY=
# Webhook endpoint: <your site>/api/stripe/webhook, events checkout.session.completed and
# checkout.session.async_payment_succeeded. Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# Optional: a Price from the Stripe dashboard. Without it, $79 USD is charged.
STRIPE_PASS_PRICE_ID=

# Google One Tap ("Continue as …" vote popup). Same Web client ID as in Supabase → Auth → Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Public address put into badge codes (e.g. https://your-site.netlify.app). On Netlify this
# defaults to the site's own address; set it locally to test badges against the live site.
# PUBLIC_SITE_URL=

# Email through Resend (resend.com). Without RESEND_API_KEY emails are skipped, nothing breaks.
# EMAIL_FROM must use a domain verified in Resend. ADMIN_EMAIL gets lead notifications
# (falls back to NEXT_PUBLIC_CONTACT_EMAIL).
RESEND_API_KEY=
EMAIL_FROM="Backlink Arena <hello@yourdomain.com>"
ADMIN_EMAIL=

# Google Analytics 4 Measurement ID (G-XXXXXXX). Loads only after the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML tag" method: the content="..." value. Not needed if you verify via DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
